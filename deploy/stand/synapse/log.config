version: 1
formatters:
  simple:
    format: "%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(message)s"
handlers:
  console:
    class: logging.StreamHandler
    formatter: simple
    level: DEBUG
loggers:
  synapse.handlers.federation_event:
    level: DEBUG
  synapse.event_auth:
    level: DEBUG
  synapse.federation.transport.client:
    level: DEBUG
  synapse.events:
    level: DEBUG
  synapse.handlers.federation:
    level: DEBUG
  synapse.federation.federation_client:
    level: DEBUG
  synapse.federation:
    level: DEBUG
  synapse.http.matrixfederationclient:
    level: DEBUG

root:
  level: INFO
  handlers: [console]
