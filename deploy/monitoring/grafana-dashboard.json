{
  "uid": "syngo-overview",
  "title": "SYNGO overview",
  "description": "Метрики описаны в docs/operations.md",
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "title": "Готовность и доступность",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "syngo_ready",
          "legendFormat": "ready {{instance}}",
          "refId": "A"
        },
        {
          "expr": "up{job=~\"syngod.*\"}",
          "legendFormat": "up {{instance}}",
          "refId": "B"
        },
        {
          "expr": "syngo_instance_lock_held",
          "legendFormat": "lock {{instance}}",
          "refId": "C"
        }
      ],
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Запросы по кодам (rate 5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(syngo_http_requests_total[5m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "title": "Доля 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(syngo_http_requests_total{code=~\"5..\"}[5m])) / sum(rate(syngo_http_requests_total[5m]))",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "title": "p99 запросов API по маршрутам (без /sync и медиа)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.99, sum by (route, le) (rate(syngo_http_request_duration_seconds_bucket{route!~\".*/sync|.*/media/.*|unmatched\"}[5m]))))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "title": "Обработка /sync без long-poll (p50/p95/p99)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(syngo_sync_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(syngo_sync_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(syngo_sync_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "title": "Ожидающие long-poll /sync",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "syngo_sync_longpoll_waiters",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "title": "Пул PostgreSQL",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "syngo_db_pool_connections",
          "legendFormat": "{{state}}",
          "refId": "A"
        },
        {
          "expr": "syngo_db_pool_max_connections",
          "legendFormat": "max",
          "refId": "B"
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "title": "Ожидание соединения пула (rate 5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(syngo_db_pool_acquire_wait_seconds_total[5m])",
          "legendFormat": "wait",
          "refId": "A"
        },
        {
          "expr": "rate(syngo_db_pool_empty_acquires_total[5m])",
          "legendFormat": "empty acquires/s",
          "refId": "B"
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "title": "Место: том медиа и база",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "syngo_media_disk_free_bytes",
          "legendFormat": "медиа свободно",
          "refId": "A"
        },
        {
          "expr": "syngo_media_disk_size_bytes",
          "legendFormat": "медиа всего",
          "refId": "B"
        },
        {
          "expr": "syngo_db_size_bytes",
          "legendFormat": "размер БД",
          "refId": "C"
        }
      ],
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },
    {
      "title": "Возраст последнего бэкапа",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - syngo_backup_last_success_timestamp_seconds",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      }
    },
    {
      "title": "Очередь push",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "syngo_push_queued_notifications",
          "legendFormat": "в очереди",
          "refId": "A"
        },
        {
          "expr": "syngo_push_active_queues",
          "legendFormat": "активных очередей",
          "refId": "B"
        },
        {
          "expr": "sum by (result) (rate(syngo_push_notifications_total[5m]))",
          "legendFormat": "{{result}}/s",
          "refId": "C"
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      }
    },
    {
      "title": "Очередь федерации: глубина и возраст",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "syngo_federation_outbox_depth",
          "legendFormat": "глубина",
          "refId": "A"
        },
        {
          "expr": "syngo_federation_outbox_oldest_seconds",
          "legendFormat": "возраст старейшего, с",
          "refId": "B"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      }
    },
    {
      "title": "Ответы 429 (rate 5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(syngo_rate_limited_total[5m])",
          "legendFormat": "429",
          "refId": "A"
        }
      ],
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      }
    },
    {
      "title": "Рантайм Go",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "go_goroutines",
          "legendFormat": "горутины",
          "refId": "A"
        },
        {
          "expr": "go_memstats_heap_alloc_bytes / 1048576",
          "legendFormat": "куча, МиБ",
          "refId": "B"
        },
        {
          "expr": "rate(go_gc_pause_seconds_total[5m]) * 1000",
          "legendFormat": "паузы GC, мс/с",
          "refId": "C"
        }
      ],
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      }
    },
    {
      "title": "State resolution: длительность (rate 5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(syngo_state_resolution_duration_seconds_total[5m])",
          "legendFormat": "длительность",
          "refId": "A"
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      }
    },
    {
      "title": "State resolution: конфликты (rate 5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(syngo_state_resolution_conflicts_total[5m])",
          "legendFormat": "конфликты",
          "refId": "A"
        }
      ],
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      }
    }
  ]
}
