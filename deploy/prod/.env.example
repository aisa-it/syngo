# Настройки продового compose. Скопируйте в deploy/prod/.env (не коммитится)
# и заполните. Секреты генерируйте: openssl rand -hex 32.

# Публичный домен сервера: часть user_id (@user:<домен>), после запуска не меняется.
SYNGOD_SERVER_NAME=matrix.example.org

# Пароль PostgreSQL: подставляется в DSN, используйте URL-безопасный (openssl rand -hex 24).
POSTGRES_PASSWORD=

# Секрет токенов /sync, не короче 32 символов.
SYNGOD_SYNC_TOKEN_SECRET=

# Регистрация оператором (/_synapse/admin/v1/register), не короче 32 символов.
# Пусто - выключена; регистрация для всех остается закрытой.
SYNGOD_REGISTRATION_SHARED_SECRET=

# Открытая регистрация для всех: true/false (по умолчанию false).
# SYNGOD_AUTH_REGISTRATION=false

# Образ: пин версии из реестра вместо локальной сборки.
# SYNGO_IMAGE=registry.example.org/syngo/syngod:v0.1.0

# Публикация порта: по умолчанию только 127.0.0.1:8008 (за TLS-прокси).
# SYNGOD_BIND=127.0.0.1
# SYNGOD_PORT=8008

# Доверенные прокси через запятую, CIDR или IP. Только от них принимаются
# X-Forwarded-For/X-Real-IP: без настройки лимиты по IP общие на всех клиентов за прокси.
# Прокси на хосте -> адрес шлюза сети compose:
#   docker network inspect <проект>_default -f '{{(index .IPAM.Config 0).Gateway}}'
# SYNGOD_TRUSTED_PROXIES=172.18.0.1
