# Скопируйте в .env (не коммитится) или задайте в переменных CI.
SYNGOD_CONFIG=config.yaml
# Окружение: dev | test | prod. По умолчанию prod: нужны server_name (не localhost), DSN и секрет >= 32 символов.
SYNGOD_ENV=dev
SYNGOD_SERVER_ADDR=:8008
SYNGOD_MATRIX_SERVER_NAME=localhost
# DSN пустой = сервис работает без БД (readiness отвечает 503)
SYNGOD_DATABASE_DSN=
# Секрет HMAC для токенов /sync (пусто = случайный на старте, токены не выживают рестарт)
SYNGOD_SYNC_TOKEN_SECRET=
# Регистрация: 1/true — открыта, 0/false — запрещена (перебивает auth.registration_open)
SYNGOD_AUTH_REGISTRATION=1
SYNGOD_LOG_LEVEL=info
SYNGOD_LOG_FORMAT=json
